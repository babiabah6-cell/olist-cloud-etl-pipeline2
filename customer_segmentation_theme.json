
{
  "name": "Customer Segmentation Professional Theme",
  "dataColors": [
    "#0B3C5D",
    "#328CC1",
    "#D9B310",
    "#D95D39",
    "#B1B1B1",
    "#1D2731"
  ],
  "background": "#F5F5F5",
  "foreground": "#1D2731",
  "tableAccent": "#0B3C5D",
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1D2731"
              }
            },
            "fontSize": 14,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "background": [
          {
            "show": false,
            "transparency": 100
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D9D9D9"
              }
            },
            "radius": 8
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#0B3C5D"
              }
            },
            "fontSize": 24
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#4F4F4F"
              }
            },
            "fontSize": 11
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "RightCenter",
            "fontSize": 10
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "general": [
          {
            "responsive": true
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D9D9D9"
              }
            }
          }
        ]
      }
    }
  }
}


